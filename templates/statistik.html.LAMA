<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Statistik — AGROTEK AI</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/main.css') }}">
    <style>
        .page-modul { min-height: 100vh; background: #f8fafc; }

        /* Navbar */
        .modul-nav {
            position: sticky; top: 0; z-index: 100;
            background: rgba(10,22,40,.95);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(255,255,255,.06);
            height: 72px; display: flex; align-items: center;
        }
        .modul-nav-inner {
            display: flex; justify-content: space-between; align-items: center;
            width: 100%; gap: 20px;
        }
        .modul-nav-links { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
        .modul-nav-links a {
            color: #cbd5e1; font-size: .85rem;
            padding: 8px 12px; border-radius: 8px;
            transition: all .2s; text-decoration: none;
        }
        .modul-nav-links a:hover { color: #fff; background: rgba(255,255,255,.06); }
        .modul-nav-links a.active { color: #6ee7b7; }
        .modul-back { color: #6ee7b7 !important; }

        /* Hero */
        .modul-hero {
            padding: 60px 0 48px;
            background: linear-gradient(180deg, #0a1628, #0f1e35);
            color: #f1f5f9;
            position: relative;
            overflow: hidden;
        }
        .modul-hero::before {
            content: '';
            position: absolute; inset: 0;
            background:
                radial-gradient(700px 400px at 15% 50%, rgba(16,185,129,.18), transparent 60%),
                radial-gradient(700px 400px at 85% 50%, rgba(14,165,233,.14), transparent 60%);
            pointer-events: none;
        }
        .modul-hero-inner { position: relative; }
        .modul-hero h1 {
            font-size: clamp(1.6rem, 3vw, 2.4rem);
            font-weight: 800;
            color: #fff;
            margin: 10px 0 8px;
            letter-spacing: -.02em;
        }
        .modul-hero p { color: #cbd5e1; max-width: 640px; font-size: .95rem; line-height: 1.6; }

        /* Content */
        .modul-content { padding: 40px 0 80px; }

        /* KPI Cards */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 18px;
            margin-bottom: 30px;
        }
        .kpi-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 22px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 1px 2px rgba(15,23,42,.06);
            transition: all .25s;
        }
        .kpi-card::before {
            content: '';
            position: absolute; left: 0; top: 0; bottom: 0;
            width: 4px;
            background: linear-gradient(180deg, #10b981, #0ea5e9);
        }
        .kpi-card:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(15,23,42,.08); }
        .kpi-label { font-size: .78rem; color: #64748b; font-weight: 500; margin-bottom: 8px; }
        .kpi-value {
            display: flex; align-items: baseline; gap: 6px;
            font-size: 1.85rem; font-weight: 800;
            color: #0f172a; letter-spacing: -.02em; line-height: 1.1;
        }
        .kpi-value small { font-size: .78rem; font-weight: 600; color: #64748b; }

        /* Charts */
        .chart-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }
        .chart-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 22px;
            box-shadow: 0 1px 2px rgba(15,23,42,.06);
        }
        .chart-card header {
            display: flex; justify-content: space-between;
            align-items: baseline; margin-bottom: 16px;
            gap: 12px; flex-wrap: wrap;
        }
        .chart-card h3 { font-size: 1rem; font-weight: 700; color: #0f172a; }
        .chart-tag {
            font-size: .7rem; color: #64748b;
            font-family: monospace;
            padding: 3px 8px;
            background: #f1f5f9;
            border-radius: 6px;
        }
        .chart-wrap { position: relative; height: 260px; }

        /* Table */
        .panel {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 22px;
            box-shadow: 0 1px 2px rgba(15,23,42,.06);
        }
        .panel header {
            display: flex; justify-content: space-between;
            align-items: center; gap: 12px;
            margin-bottom: 16px; flex-wrap: wrap;
        }
        .panel h3 { font-size: 1rem; font-weight: 700; color: #0f172a; }

        .search-box {
            display: flex; align-items: center; gap: 8px;
            padding: 8px 12px;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            background: #f8fafc;
            color: #64748b;
            min-width: 220px;
        }
        .search-box input {
            border: none; background: transparent;
            font: inherit; font-size: .85rem;
            color: #0f172a; outline: none; width: 100%;
        }
        .search-box input::placeholder { color: #94a3b8; }

        .data-table {
            width: 100%; border-collapse: collapse;
            font-size: .88rem;
        }
        .data-table th {
            text-align: left;
            font-size: .72rem; text-transform: uppercase;
            letter-spacing: .08em; color: #64748b;
            font-weight: 600;
            padding: 10px; border-bottom: 1px solid #e2e8f0;
        }
        .data-table td {
            padding: 12px 10px;
            border-bottom: 1px solid #e2e8f0;
            color: #334155;
        }
        .data-table tr:last-child td { border-bottom: none; }
        .data-table tr:hover td { background: rgba(16,185,129,.03); }
        .mono { font-family: monospace; font-size: .82rem; color: #64748b; }

        .pill {
            display: inline-block;
            padding: 3px 10px;
            font-size: .72rem;
            font-weight: 600;
            border-radius: 999px;
            background: rgba(16,185,129,.12);
            color: #059669;
        }

        @media (max-width: 900px) {
            .chart-grid { grid-template-columns: 1fr; }
        }
        @media (max-width: 640px) {
            .kpi-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
            .kpi-value { font-size: 1.4rem; }
            .modul-nav-links { display: none; }
        }
    </style>
</head>
<body class="page-modul">

<header class="modul-nav">
    <div class="container modul-nav-inner">
        <a href="/hub" class="brand">
            <span class="brand-mark">AG</span>
            <span class="brand-text">
                <strong>AGROTEK AI</strong>
                <small>Spatial Agriculture Intelligence Platform</small>
            </span>
        </a>
        <nav class="modul-nav-links">
            <a href="/statistik" class="active">Statistik</a>
            <a href="/hidrologi">Hidrologi</a>
            <a href="/peta">Peta</a>
            <a href="/analisis">Analisis</a>
            <a href="/data">Data</a>
            <a href="/hub" class="modul-back">← Hub</a>
        </nav>
    </div>
</header>

<section class="modul-hero">
    <div class="container modul-hero-inner">
        <span class="eyebrow eyebrow-light">Statistik</span>
        <h1>Statistik Wilayah Jember</h1>
        <p>Ringkasan data spasial dan statistik Kabupaten Jember. Angka DEMO — akan tersinkronisasi otomatis dengan database PostGIS.</p>
    </div>
</section>

<section class="modul-content">
    <div class="container">

        <!-- KPI -->
        <div class="kpi-grid">
            {% for s in stats %}
            <div class="kpi-card">
                <div class="kpi-label">{{ s.label }}</div>
                <div class="kpi-value">
                    {{ s.value }}{% if s.unit %} <small>{{ s.unit }}</small>{% endif %}
                </div>
            </div>
            {% endfor %}
        </div>

        <!-- Charts -->
        <div class="chart-grid">
            <div class="chart-card">
                <header>
                    <h3>Produksi Komoditas</h3>
                    <span class="chart-tag">ribu ton · DEMO</span>
                </header>
                <div class="chart-wrap"><canvas id="chartCrops"></canvas></div>
            </div>

            <div class="chart-card">
                <header>
                    <h3>Penggunaan Lahan</h3>
                    <span class="chart-tag">ribu ha · DEMO</span>
                </header>
                <div class="chart-wrap"><canvas id="chartLandUse"></canvas></div>
            </div>
        </div>

        <!-- Table Kecamatan -->
        <div class="panel">
            <header>
                <h3>Daftar Kecamatan</h3>
                <div class="search-box">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                    <input type="text" id="searchKecamatan" placeholder="Cari kecamatan...">
                </div>
            </header>
            <table class="data-table" id="tabelKecamatan">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Kecamatan</th>
                        <th>Luas (km²)</th>
                        <th>Jumlah Desa</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td class="mono">1</td><td><strong>Kencong</strong></td><td>62.4</td><td>5</td><td><span class="pill">Aktif</span></td></tr>
                    <tr><td class="mono">2</td><td><strong>Gumukmas</strong></td><td>93.2</td><td>8</td><td><span class="pill">Aktif</span></td></tr>
                    <tr><td class="mono">3</td><td><strong>Puger</strong></td><td>142.6</td><td>12</td><td><span class="pill">Aktif</span></td></tr>
                    <tr><td class="mono">4</td><td><strong>Wuluhan</strong></td><td>105.2</td><td>7</td><td><span class="pill">Aktif</span></td></tr>
                    <tr><td class="mono">5</td><td><strong>Ambulu</strong></td><td>103.5</td><td>7</td><td><span class="pill">Aktif</span></td></tr>
                    <tr><td class="mono">6</td><td><strong>Tempurejo</strong></td><td>210.4</td><td>8</td><td><span class="pill">Aktif</span></td></tr>
                    <tr><td class="mono">7</td><td><strong>Silo</strong></td><td>206.3</td><td>9</td><td><span class="pill">Aktif</span></td></tr>
                    <tr><td class="mono">8</td><td><strong>Mayang</strong></td><td>60.3</td><td>7</td><td><span class="pill">Aktif</span></td></tr>
                    <tr><td class="mono">9</td><td><strong>Mumbulsari</strong></td><td>56.8</td><td>7</td><td><span class="pill">Aktif</span></td></tr>
                    <tr><td class="mono">10</td><td><strong>Jenggawah</strong></td><td>48.7</td><td>8</td><td><span class="pill">Aktif</span></td></tr>
                </tbody>
            </table>
            <p style="text-align:center;color:#94a3b8;font-size:.8rem;margin-top:14px;">
                Menampilkan 10 dari 31 kecamatan (DEMO)
            </p>
        </div>

    </div>
</section>

<!-- Chart.js dari CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="{{ url_for('static', filename='js/statistik.js') }}"></script>

</body>
</html>