<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#050b18">
    <title>Hub Modul — AGROTEK AI</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --navy-950: #050b18;
            --navy-900: #0a1628;
            --navy-800: #0f1e35;
            --navy-700: #142744;
            --emerald-500: #10b981;
            --emerald-400: #34d399;
            --emerald-300: #6ee7b7;
            --sky-500: #0ea5e9;
            --sky-400: #38bdf8;
            --amber-400: #fbbf24;
            --purple-500: #a855f7;
            --red-500: #ef4444;
            --cyan-500: #06b6d4;

            --text-light: #f1f5f9;
            --muted-light: #94a3b8;
            --muted-2: #64748b;

            --font-display: 'Space Grotesk', -apple-system, sans-serif;
            --font-body: 'Inter', -apple-system, sans-serif;

            --container: 1280px;
            --ease: cubic-bezier(.16,1,.3,1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            font-family: var(--font-body);
            background: var(--navy-950);
            color: var(--text-light);
            line-height: 1.6;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }
        a { color: inherit; text-decoration: none; }
        ul { list-style: none; }
        button { font: inherit; cursor: pointer; border: none; background: none; color: inherit; }

        /* Noise texture */
        body::before {
            content: '';
            position: fixed; inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.4'/%3E%3C/svg%3E");
            opacity: 0.035;
            pointer-events: none;
            z-index: 1;
            mix-blend-mode: overlay;
        }

        .container {
            max-width: var(--container);
            margin: 0 auto;
            padding: 0 24px;
        }

        /* ============================================================
           NAVBAR
           ============================================================ */
        .nav {
            position: sticky;
            top: 0;
            z-index: 100;
            height: 72px;
            display: flex; align-items: center;
            background: rgba(5, 11, 24, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,.05);
        }
        .nav-inner {
            display: flex; align-items: center;
            justify-content: space-between;
            width: 100%; gap: 24px;
        }
        .brand {
            display: flex; align-items: center; gap: 12px;
            font-family: var(--font-display);
        }
        .brand-mark {
            width: 40px; height: 40px;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--emerald-400), var(--sky-400));
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; color: var(--navy-950);
            font-size: .85rem;
            box-shadow: 0 4px 20px rgba(16,185,129,.4);
        }
        .brand-text strong {
            display: block; font-size: 1rem; font-weight: 700;
            color: #fff; letter-spacing: .01em;
        }
        .brand-text small {
            display: block; font-size: .65rem;
            color: var(--emerald-300); letter-spacing: .05em;
        }

        .nav-user {
            display: flex; align-items: center; gap: 14px;
        }
        .user-avatar {
            width: 40px; height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--emerald-400), var(--sky-400));
            display: flex; align-items: center; justify-content: center;
            font-family: var(--font-display);
            font-weight: 700; color: var(--navy-950);
            font-size: .95rem;
            box-shadow: 0 4px 16px rgba(16,185,129,.4);
        }
        .user-info {
            display: flex; flex-direction: column; line-height: 1.15;
        }
        .user-info strong { font-size: .9rem; color: #fff; font-weight: 600; }
        .user-info small {
            font-size: .68rem;
            color: var(--emerald-300);
            text-transform: uppercase;
            letter-spacing: .08em;
            font-weight: 600;
        }
        .btn-logout {
            padding: 9px 18px;
            border-radius: 999px;
            background: rgba(255,255,255,.05);
            border: 1px solid rgba(255,255,255,.1);
            color: var(--muted-light);
            font-size: .82rem;
            font-weight: 600;
            transition: all .2s;
        }
        .btn-logout:hover {
            background: rgba(239,68,68,.15);
            border-color: rgba(239,68,68,.4);
            color: #f87171;
        }

        /* ============================================================
           HERO MINI
           ============================================================ */
        .hero {
            position: relative;
            padding: 60px 0 40px;
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute; inset: 0;
            background:
                radial-gradient(700px 400px at 15% 30%, rgba(16,185,129,.15), transparent 60%),
                radial-gradient(700px 400px at 85% 70%, rgba(14,165,233,.1), transparent 60%);
            pointer-events: none;
        }
        .hero-grid-bg {
            position: absolute; inset: 0;
            background-image:
                linear-gradient(rgba(52,211,153,.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(52,211,153,.04) 1px, transparent 1px);
            background-size: 48px 48px;
            mask-image: radial-gradient(ellipse at 50% 40%, black 20%, transparent 75%);
            -webkit-mask-image: radial-gradient(ellipse at 50% 40%, black 20%, transparent 75%);
            pointer-events: none;
        }
        .hero-inner {
            position: relative;
            z-index: 2;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 40px;
            align-items: end;
        }
        .hero-left { max-width: 720px; }
        .hero-badge {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 6px 14px;
            background: rgba(52,211,153,.1);
            border: 1px solid rgba(52,211,153,.3);
            color: var(--emerald-300);
            border-radius: 999px;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .15em;
            text-transform: uppercase;
            margin-bottom: 20px;
        }
        .hero-title {
            font-family: var(--font-display);
            font-size: clamp(1.8rem, 3.5vw, 2.75rem);
            font-weight: 700;
            letter-spacing: -.03em;
            line-height: 1.1;
            color: #fff;
            margin-bottom: 14px;
        }
        .hero-title .grad {
            background: linear-gradient(135deg, var(--emerald-300), var(--sky-400));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
        }
        .hero-sub {
            font-size: 1rem;
            color: var(--muted-light);
            line-height: 1.6;
            max-width: 620px;
        }

        .hero-stats {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            align-items: flex-end;
        }
        .stat-mini {
            padding: 16px 20px;
            background: linear-gradient(180deg, rgba(15,30,53,.7), rgba(10,22,40,.5));
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 14px;
            min-width: 110px;
            backdrop-filter: blur(10px);
        }
        .stat-mini-label {
            font-size: .62rem;
            color: var(--muted-light);
            text-transform: uppercase;
            letter-spacing: .1em;
            font-weight: 600;
            margin-bottom: 6px;
        }
        .stat-mini-value {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -.03em;
            color: #fff;
            line-height: 1;
        }
        .stat-mini-value small {
            font-size: .7rem;
            color: var(--muted-light);
            font-family: var(--font-body);
            font-weight: 500;
            margin-left: 3px;
        }

        /* ============================================================
           BENTO GRID
           ============================================================ */
        .bento-section {
            padding: 20px 0 80px;
            position: relative;
        }

        .bento {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-auto-rows: 200px;
            grid-auto-flow: dense;
            gap: 16px;
        }

        .bento-card {
            position: relative;
            padding: 26px;
            background: linear-gradient(180deg, rgba(15,30,53,.7), rgba(10,22,40,.5));
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 20px;
            overflow: hidden;
            transition: all .4s var(--ease);
            cursor: pointer;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .bento-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(400px 300px at 0% 0%, rgba(52,211,153,.15), transparent 60%);
            opacity: 0;
            transition: opacity .4s;
            pointer-events: none;
        }
        .bento-card:hover {
            border-color: rgba(52,211,153,.35);
            transform: translateY(-4px);
            box-shadow: 0 20px 50px rgba(0,0,0,.4);
        }
        .bento-card:hover::before { opacity: 1; }

        .bento-icon {
            width: 48px; height: 48px;
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 16px;
            position: relative;
        }
        .bento-icon.emerald { background: linear-gradient(135deg, var(--emerald-500), #059669); box-shadow: 0 8px 24px rgba(16,185,129,.4); }
        .bento-icon.sky     { background: linear-gradient(135deg, var(--sky-500), #0284c7);     box-shadow: 0 8px 24px rgba(14,165,233,.4); }
        .bento-icon.amber   { background: linear-gradient(135deg, #f59e0b, #d97706);            box-shadow: 0 8px 24px rgba(245,158,11,.4); }
        .bento-icon.purple  { background: linear-gradient(135deg, var(--purple-500), #7c3aed);  box-shadow: 0 8px 24px rgba(168,85,247,.4); }
        .bento-icon.red     { background: linear-gradient(135deg, var(--red-500), #dc2626);     box-shadow: 0 8px 24px rgba(239,68,68,.4); }
        .bento-icon.cyan    { background: linear-gradient(135deg, var(--cyan-500), #0891b2);    box-shadow: 0 8px 24px rgba(6,182,212,.4); }

        .bento-card h3 {
            font-family: var(--font-display);
            font-size: 1.2rem;
            font-weight: 700;
            letter-spacing: -.02em;
            color: #fff;
            margin-bottom: 6px;
        }
        .bento-card p {
            font-size: .85rem;
            color: var(--muted-light);
            line-height: 1.55;
        }
        .bento-card .bento-tag {
            position: absolute;
            top: 22px; right: 22px;
            font-family: 'JetBrains Mono', monospace;
            font-size: .62rem;
            color: var(--emerald-300);
            padding: 3px 10px;
            background: rgba(52,211,153,.1);
            border: 1px solid rgba(52,211,153,.25);
            border-radius: 999px;
            letter-spacing: .05em;
            font-weight: 600;
        }
        .bento-card .bento-arrow {
            font-size: 1.15rem;
            color: var(--emerald-400);
            transition: transform .3s;
            align-self: flex-end;
            margin-top: 12px;
        }
        .bento-card:hover .bento-arrow { transform: translateX(6px); }

        /* Bento sizes */
        .bento-card.large {
            grid-column: span 2;
            grid-row: span 2;
            padding: 32px;
        }
        .bento-card.large h3 { font-size: 1.65rem; margin-bottom: 10px; }
        .bento-card.large p { font-size: .95rem; }

        .bento-card.wide { grid-column: span 2; }
        .bento-card.tall { grid-row: span 2; }

        /* Map preview decoration untuk kartu besar */
        .bento-card.map-decor::after {
            content: '';
            position: absolute;
            right: -40px; bottom: -40px;
            width: 240px; height: 240px;
            background:
                radial-gradient(circle at 30% 30%, rgba(16,185,129,.4), transparent 55%),
                radial-gradient(circle at 70% 70%, rgba(14,165,233,.35), transparent 55%);
            border-radius: 50%;
            filter: blur(20px);
            opacity: .6;
            pointer-events: none;
        }

        /* Pattern kecil untuk variasi */
        .bento-card.pattern-dots::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle, rgba(52,211,153,.15) 1px, transparent 1px);
            background-size: 20px 20px;
            mask-image: linear-gradient(135deg, transparent 40%, black);
            -webkit-mask-image: linear-gradient(135deg, transparent 40%, black);
            pointer-events: none;
        }

        /* ============================================================
           REVEAL ANIMATION
           ============================================================ */
        .reveal {
            opacity: 0;
            transform: translateY(24px);
            transition: opacity .7s var(--ease), transform .7s var(--ease);
        }
        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* ============================================================
           FOOTER MINI
           ============================================================ */
        .footer-mini {
            padding: 32px 0;
            background: #030711;
            border-top: 1px solid rgba(52,211,153,.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
            font-size: .82rem;
            color: var(--muted-2);
        }
        .footer-mini .status {
            display: inline-flex; align-items: center; gap: 8px;
            color: var(--emerald-300);
        }
        .footer-mini .status .dot {
            width: 6px; height: 6px;
            background: var(--emerald-400);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--emerald-400);
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%,100% { opacity: 1; }
            50% { opacity: .4; }
        }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @media (max-width: 1024px) {
            .bento {
                grid-template-columns: repeat(2, 1fr);
                grid-auto-rows: 180px;
            }
            .bento-card.large { grid-column: span 2; grid-row: span 2; }
            .hero-inner { grid-template-columns: 1fr; }
            .hero-stats { margin-top: 20px; }
        }

        @media (max-width: 640px) {
            .container { padding: 0 16px; }
            .nav { height: 64px; }
            .brand-text small { display: none; }
            .user-info { display: none; }
            .bento {
                grid-template-columns: 1fr;
                grid-auto-rows: auto;
            }
            .bento-card.large,
            .bento-card.wide,
            .bento-card.tall {
                grid-column: auto;
                grid-row: auto;
                padding: 24px;
                min-height: 160px;
            }
            .bento-card.large h3 { font-size: 1.25rem; }
            .hero-title { font-size: 1.6rem; }
            .stat-mini { flex: 1; }
        }
    </style>
</head>
<body>

<!-- ============================================================
     NAVBAR
     ============================================================ -->
<nav class="nav">
    <div class="container nav-inner">
        <a href="/hub" class="brand">
            <span class="brand-mark">AG</span>
            <span class="brand-text">
                <strong>AGROTEK AI</strong>
                <small>SPATIAL AGRICULTURE INTELLIGENCE</small>
            </span>
        </a>

        <div class="nav-user">
            <div class="user-avatar">{{ user.name[0]|upper if user else 'U' }}</div>
            <div class="user-info">
                <strong>{{ user.name if user else 'User' }}</strong>
                <small>{{ role|upper if role else 'USER' }}</small>
            </div>
            <a href="/logout" class="btn-logout">Keluar</a>
        </div>
    </div>
</nav>

<!-- ============================================================
     HERO MINI
     ============================================================ -->
<section class="hero">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="container hero-inner">

        <div class="hero-left">
            <div class="hero-badge">
                <span class="dot" style="width:6px;height:6px;background:#34d399;border-radius:50%;box-shadow:0 0 8px #34d399;animation:pulse 2s infinite;"></span>
                {{ role|upper if role else 'USER' }} · AKUN AKTIF
            </div>

            <h1 class="hero-title">
                Selamat Datang,<br>
                <span class="grad">{{ user.name if user else 'User' }}</span>
            </h1>

            <p class="hero-sub">
                Pilih modul untuk mulai bekerja. Setiap modul dirancang modular
                dan terintegrasi dalam satu platform.
            </p>
        </div>

        <div class="hero-stats">
            <div class="stat-mini">
                <div class="stat-mini-label">Modul</div>
                <div class="stat-mini-value">{{ modules|length }}</div>
            </div>
            <div class="stat-mini">
                <div class="stat-mini-label">Status</div>
                <div class="stat-mini-value" style="color:#34d399;">●</div>
            </div>
        </div>

    </div>
</section>

<!-- ============================================================
     BENTO GRID
     ============================================================ -->
<section class="bento-section">
    <div class="container">

        {% set large_ids = ['peta3d'] %}
        {% set wide_ids = ['ai', 'risiko', 'admin'] %}
        {% set tall_ids = ['iot'] %}

        <div class="bento">
            {% for m in modules %}
                {% set size_class = '' %}
                {% if m.id in large_ids %}
                    {% set size_class = 'large map-decor' %}
                {% elif m.id in wide_ids %}
                    {% set size_class = 'wide' %}
                {% elif m.id in tall_ids %}
                    {% set size_class = 'tall pattern-dots' %}
                {% endif %}

                <a href="{{ url_for(m.endpoint) }}" class="bento-card {{ size_class }} reveal">
                    <span class="bento-tag">{{ m.id|upper }}</span>
                    <div>
                        <div class="bento-icon {{ m.color }}">{{ m.icon }}</div>
                        <h3>{{ m.title }}</h3>
                        <p>{{ m.desc }}</p>
                    </div>
                    <div class="bento-arrow">→</div>
                </a>
            {% endfor %}
        </div>

    </div>
</section>

<!-- ============================================================
     FOOTER MINI
     ============================================================ -->
<footer class="footer-mini">
    <div class="container" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px;width:100%;">
        <div>&copy; 2026 AGROTEK AI — Kabupaten Jember</div>
        <div class="status">
            <span class="dot"></span>
            System Online
        </div>
    </div>
</footer>

<!-- ============================================================
     REVEAL SCRIPT
     ============================================================ -->
<script>
(function() {
    'use strict';

    const reveals = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
            entries.forEach((e, i) => {
                if (e.isIntersecting) {
                    setTimeout(() => e.target.classList.add('visible'), i * 50);
                    io.unobserve(e.target);
                }
            });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        reveals.forEach(el => io.observe(el));
    } else {
        reveals.forEach(el => el.classList.add('visible'));
    }
})();
</script>

</body>
</html>