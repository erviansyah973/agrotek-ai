<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="AGROTEK AI — Spatial Agriculture Intelligence Platform Kabupaten Jember.">
    <meta name="theme-color" content="#050b18">
    <title>AGROTEK AI — Spatial Agriculture Intelligence Platform</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css">

    <style>
        /* ============================================================
           TOKENS
           ============================================================ */
        :root {
            --navy-950: #050b18;
            --navy-900: #0a1628;
            --navy-800: #0f1e35;
            --navy-700: #142744;
            --emerald-500: #10b981;
            --emerald-400: #34d399;
            --emerald-300: #6ee7b7;
            --sky-500: #0ea5e9;
            --sky-400: #38bdf8;
            --amber-400: #fbbf24;
            --purple-500: #a855f7;
            --red-500: #ef4444;

            --text-light: #f1f5f9;
            --muted-light: #94a3b8;
            --muted-2: #64748b;
            --border-dark: rgba(255,255,255,.08);

            --font-display: 'Space Grotesk', -apple-system, sans-serif;
            --font-body: 'Inter', -apple-system, sans-serif;

            --container: 1280px;
            --ease: cubic-bezier(.16,1,.3,1);
            --ease-out: cubic-bezier(.22,.61,.36,1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            font-family: var(--font-body);
            background: var(--navy-950);
            color: var(--text-light);
            line-height: 1.6;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }
        a { color: inherit; text-decoration: none; }
        ul { list-style: none; }
        img, svg { display: block; max-width: 100%; }
        button { font: inherit; cursor: pointer; border: none; background: none; color: inherit; }

        .container {
            max-width: var(--container);
            margin: 0 auto;
            padding: 0 24px;
        }

        /* Noise texture overlay */
        body::before {
            content: '';
            position: fixed; inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.4'/%3E%3C/svg%3E");
            opacity: 0.04;
            pointer-events: none;
            z-index: 1;
            mix-blend-mode: overlay;
        }

        /* ============================================================
           NAVBAR
           ============================================================ */
        .nav {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 1000;
            height: 72px;
            display: flex; align-items: center;
            background: rgba(5, 11, 24, 0.4);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,.04);
            transition: all .3s var(--ease);
        }
        .nav.scrolled {
            background: rgba(5, 11, 24, 0.9);
            border-bottom-color: rgba(52,211,153,.15);
            box-shadow: 0 4px 30px rgba(0,0,0,.4);
        }
        .nav-inner {
            display: flex; align-items: center;
            justify-content: space-between;
            width: 100%; gap: 24px;
        }
        .brand {
            display: flex; align-items: center; gap: 12px;
            font-family: var(--font-display);
        }
        .brand-mark {
            width: 40px; height: 40px;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--emerald-400), var(--sky-400));
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; color: var(--navy-950);
            font-size: .85rem;
            box-shadow: 0 4px 20px rgba(16,185,129,.4);
        }
        .brand-text strong {
            display: block; font-size: 1rem; font-weight: 700;
            color: #fff; letter-spacing: .01em;
        }
        .brand-text small {
            display: block; font-size: .65rem;
            color: var(--emerald-300); letter-spacing: .05em;
        }

        .nav-links {
            display: flex; align-items: center; gap: 4px;
        }
        .nav-links a {
            padding: 8px 14px;
            font-size: .85rem; font-weight: 500;
            color: var(--muted-light);
            border-radius: 8px;
            transition: all .2s;
        }
        .nav-links a:hover {
            color: #fff;
            background: rgba(255,255,255,.05);
        }

        .btn {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 11px 22px;
            border-radius: 999px;
            font-family: var(--font-body);
            font-weight: 600;
            font-size: .88rem;
            letter-spacing: .01em;
            transition: all .25s var(--ease);
            cursor: pointer;
            border: 1px solid transparent;
            white-space: nowrap;
        }
        .btn-primary {
            background: linear-gradient(135deg, var(--emerald-500), var(--emerald-400));
            color: var(--navy-950);
            box-shadow: 0 4px 24px rgba(16,185,129,.4);
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 32px rgba(16,185,129,.55);
        }
        .btn-ghost {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.12);
            color: var(--text-light);
            backdrop-filter: blur(10px);
        }
        .btn-ghost:hover {
            background: rgba(255,255,255,.1);
            border-color: rgba(52,211,153,.4);
            transform: translateY(-2px);
        }
        .btn-lg { padding: 15px 30px; font-size: 1rem; }

        /* ============================================================
           HERO
           ============================================================ */
        .hero {
            position: relative;
            min-height: 100vh;
            padding: 120px 0 60px;
            display: flex;
            align-items: center;
            overflow: hidden;
        }

        /* Gradient mesh background */
        .hero-bg {
            position: absolute; inset: 0;
            z-index: 0;
        }
        .hero-mesh {
            position: absolute; inset: 0;
            background:
                radial-gradient(900px 600px at 15% 20%, rgba(16,185,129,.20), transparent 55%),
                radial-gradient(800px 700px at 85% 60%, rgba(14,165,233,.16), transparent 55%),
                radial-gradient(700px 500px at 50% 100%, rgba(52,211,153,.10), transparent 60%),
                linear-gradient(180deg, #050b18 0%, #0a1628 60%, #0f1e35 100%);
        }
        .hero-grid {
            position: absolute; inset: 0;
            background-image:
                linear-gradient(rgba(52,211,153,.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(52,211,153,.06) 1px, transparent 1px);
            background-size: 64px 64px;
            mask-image: radial-gradient(ellipse at 50% 40%, black 20%, transparent 80%);
            -webkit-mask-image: radial-gradient(ellipse at 50% 40%, black 20%, transparent 80%);
        }

        .hero-inner {
            position: relative;
            z-index: 2;
            display: grid;
            grid-template-columns: 1.1fr 1fr;
            gap: 60px;
            align-items: center;
            width: 100%;
        }

        /* Hero Left */
        .hero-left { max-width: 620px; }
        .hero-eyebrow {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 6px 14px;
            background: rgba(52,211,153,.1);
            border: 1px solid rgba(52,211,153,.3);
            color: var(--emerald-300);
            border-radius: 999px;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .15em;
            text-transform: uppercase;
            margin-bottom: 24px;
        }
        .hero-eyebrow .dot {
            width: 6px; height: 6px;
            background: var(--emerald-400);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--emerald-400);
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%,100% { opacity: 1; }
            50% { opacity: .4; }
        }

        .hero-title {
            font-family: var(--font-display);
            font-size: clamp(2.5rem, 5.5vw, 4.5rem);
            font-weight: 700;
            line-height: 1.02;
            letter-spacing: -.035em;
            margin-bottom: 24px;
            color: #fff;
        }
        .hero-title .grad {
            background: linear-gradient(135deg, var(--emerald-300) 0%, var(--sky-400) 60%, var(--emerald-400) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
        }

        .hero-sub {
            font-size: clamp(1rem, 1.2vw, 1.15rem);
            color: var(--muted-light);
            line-height: 1.7;
            margin-bottom: 36px;
            max-width: 560px;
        }

        .hero-actions {
            display: flex; gap: 12px; flex-wrap: wrap;
            margin-bottom: 40px;
        }

        .hero-metrics {
            display: flex; gap: 32px; flex-wrap: wrap;
            padding-top: 24px;
            border-top: 1px solid rgba(255,255,255,.08);
        }
        .hero-metric-label {
            font-size: .72rem;
            color: var(--muted-2);
            text-transform: uppercase;
            letter-spacing: .08em;
            margin-bottom: 4px;
        }
        .hero-metric-value {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            color: #fff;
            letter-spacing: -.02em;
        }
        .hero-metric-value .unit {
            font-size: .8rem;
            color: var(--muted-light);
            font-family: var(--font-body);
            font-weight: 500;
            margin-left: 4px;
        }

        /* Hero Right — 3D Map Card */
        .hero-right {
            position: relative;
            height: 540px;
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid rgba(52,211,153,.2);
            box-shadow:
                0 30px 80px rgba(0,0,0,.5),
                0 0 0 1px rgba(255,255,255,.03),
                inset 0 1px 0 rgba(255,255,255,.05);
            background: var(--navy-900);
        }
        #heroMap {
            position: absolute;
            inset: 0;
            opacity: 0;
            transition: opacity 1.2s var(--ease);
        }
        #heroMap.ready { opacity: 1; }

        .hero-map-fallback {
            position: absolute; inset: 0;
            display: flex; align-items: center; justify-content: center;
            background:
                radial-gradient(400px 300px at 30% 30%, rgba(16,185,129,.15), transparent 60%),
                radial-gradient(400px 300px at 70% 70%, rgba(14,165,233,.12), transparent 60%),
                linear-gradient(180deg, #071a2e, #0a2a3f);
            transition: opacity .6s;
        }
        .hero-map-fallback.hide { opacity: 0; pointer-events: none; }

        /* Floating data cards di atas peta */
        .floating-card {
            position: absolute;
            z-index: 10;
            background: rgba(10,22,40,.88);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(52,211,153,.3);
            border-radius: 12px;
            padding: 12px 16px;
            box-shadow: 0 12px 32px rgba(0,0,0,.4);
            pointer-events: none;
            animation: floatY 4s ease-in-out infinite;
        }
        @keyframes floatY {
            0%,100% { transform: translateY(0); }
            50% { transform: translateY(-6px); }
        }
        .floating-card .fc-label {
            font-size: .65rem;
            color: var(--muted-light);
            text-transform: uppercase;
            letter-spacing: .08em;
            margin-bottom: 4px;
            display: flex; align-items: center; gap: 6px;
        }
        .floating-card .fc-value {
            font-family: var(--font-display);
            font-size: 1.1rem;
            font-weight: 700;
            color: #fff;
            letter-spacing: -.02em;
        }
        .floating-card .fc-value small {
            font-size: .7rem;
            color: var(--muted-light);
            font-family: var(--font-body);
            font-weight: 500;
            margin-left: 3px;
        }
        .floating-card .fc-dot {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: var(--emerald-400);
            box-shadow: 0 0 8px var(--emerald-400);
        }
        .fc-1 { top: 20px; left: 20px; animation-delay: 0s; }
        .fc-2 { top: 20px; right: 20px; animation-delay: 1s; }
        .fc-3 { bottom: 20px; left: 20px; animation-delay: 2s; }
        .fc-4 { bottom: 20px; right: 20px; animation-delay: 1.5s; }

        .hero-map-badge {
            position: absolute;
            top: 20px; left: 50%;
            transform: translateX(-50%);
            z-index: 11;
            padding: 6px 14px;
            background: rgba(10,22,40,.9);
            border: 1px solid rgba(52,211,153,.35);
            border-radius: 999px;
            font-family: 'JetBrains Mono', monospace;
            font-size: .7rem;
            color: var(--emerald-300);
            letter-spacing: .05em;
            backdrop-filter: blur(8px);
        }

        /* ============================================================
           LIVE TICKER
           ============================================================ */
        .ticker {
            position: relative;
            padding: 20px 0;
            background: linear-gradient(90deg, var(--navy-900), var(--navy-800), var(--navy-900));
            border-top: 1px solid rgba(52,211,153,.15);
            border-bottom: 1px solid rgba(52,211,153,.15);
            overflow: hidden;
        }
        .ticker::before,
        .ticker::after {
            content: '';
            position: absolute;
            top: 0; bottom: 0;
            width: 120px;
            z-index: 2;
            pointer-events: none;
        }
        .ticker::before {
            left: 0;
            background: linear-gradient(90deg, var(--navy-900), transparent);
        }
        .ticker::after {
            right: 0;
            background: linear-gradient(-90deg, var(--navy-900), transparent);
        }
        .ticker-track {
            display: flex;
            gap: 60px;
            animation: scrollX 40s linear infinite;
            white-space: nowrap;
        }
        @keyframes scrollX {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }
        .ticker-item {
            display: inline-flex; align-items: center; gap: 12px;
            font-size: .85rem;
            color: var(--muted-light);
        }
        .ticker-item strong {
            color: #fff;
            font-family: var(--font-display);
            font-weight: 600;
            font-size: .95rem;
        }
        .ticker-item .live-dot {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: var(--emerald-400);
            box-shadow: 0 0 8px var(--emerald-400);
            animation: pulse 1.5s infinite;
        }

        /* ============================================================
           SECTION COMMON
           ============================================================ */
        .section {
            position: relative;
            padding: 100px 0;
        }
        .section-head {
            max-width: 720px;
            margin-bottom: 60px;
        }
        .section-head.center { margin-left: auto; margin-right: auto; text-align: center; }
        .section-eyebrow {
            display: inline-block;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .15em;
            text-transform: uppercase;
            color: var(--emerald-300);
            margin-bottom: 16px;
            padding: 5px 12px;
            background: rgba(52,211,153,.08);
            border: 1px solid rgba(52,211,153,.2);
            border-radius: 999px;
        }
        .section-title {
            font-family: var(--font-display);
            font-size: clamp(2rem, 3.5vw, 2.75rem);
            font-weight: 700;
            letter-spacing: -.03em;
            line-height: 1.1;
            color: #fff;
            margin-bottom: 16px;
        }
        .section-sub {
            font-size: 1.05rem;
            color: var(--muted-light);
            line-height: 1.7;
            max-width: 600px;
        }
        .section-head.center .section-sub { margin-left: auto; margin-right: auto; }

        /* ============================================================
           STATS
           ============================================================ */
        .stats-section {
            background: linear-gradient(180deg, var(--navy-950), var(--navy-900));
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0;
            border: 1px solid rgba(52,211,153,.15);
            border-radius: 20px;
            overflow: hidden;
            background: linear-gradient(180deg, rgba(15,30,53,.6), rgba(10,22,40,.4));
            backdrop-filter: blur(10px);
        }
        .stat-item {
            padding: 40px 32px;
            border-right: 1px solid rgba(52,211,153,.1);
            position: relative;
            overflow: hidden;
        }
        .stat-item:last-child { border-right: none; }
        .stat-item::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--emerald-400), transparent);
            opacity: 0;
            transition: opacity .4s;
        }
        .stat-item:hover::before { opacity: 1; }

        .stat-label {
            font-size: .72rem;
            color: var(--muted-light);
            text-transform: uppercase;
            letter-spacing: .12em;
            font-weight: 600;
            margin-bottom: 12px;
        }
        .stat-value {
            font-family: var(--font-display);
            font-size: clamp(2.5rem, 4vw, 3.5rem);
            font-weight: 700;
            letter-spacing: -.04em;
            line-height: 1;
            color: #fff;
            margin-bottom: 8px;
            display: flex; align-items: baseline; gap: 6px;
        }
        .stat-value .unit {
            font-size: .85rem;
            color: var(--muted-light);
            font-family: var(--font-body);
            font-weight: 500;
        }
        .stat-spark {
            height: 24px;
            margin-top: 12px;
        }
        .stat-spark svg { width: 100%; height: 100%; }

        /* ============================================================
           BENTO GRID
           ============================================================ */
        .bento-section {
            background: linear-gradient(180deg, var(--navy-900), var(--navy-950));
        }
        .bento {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-auto-rows: 220px;
            gap: 16px;
        }
        .bento-card {
            position: relative;
            padding: 28px;
            background: linear-gradient(180deg, rgba(15,30,53,.7), rgba(10,22,40,.5));
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 20px;
            overflow: hidden;
            transition: all .4s var(--ease);
            cursor: pointer;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .bento-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(400px 300px at 0% 0%, rgba(52,211,153,.15), transparent 60%);
            opacity: 0;
            transition: opacity .4s;
            pointer-events: none;
        }
        .bento-card:hover {
            border-color: rgba(52,211,153,.35);
            transform: translateY(-4px);
            box-shadow: 0 20px 50px rgba(0,0,0,.4);
        }
        .bento-card:hover::before { opacity: 1; }

        .bento-icon {
            width: 48px; height: 48px;
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 16px;
            position: relative;
        }
        .bento-icon.emerald { background: linear-gradient(135deg, var(--emerald-500), #059669); box-shadow: 0 8px 24px rgba(16,185,129,.4); }
        .bento-icon.sky     { background: linear-gradient(135deg, var(--sky-500), #0284c7);     box-shadow: 0 8px 24px rgba(14,165,233,.4); }
        .bento-icon.amber   { background: linear-gradient(135deg, #f59e0b, #d97706);            box-shadow: 0 8px 24px rgba(245,158,11,.4); }
        .bento-icon.purple  { background: linear-gradient(135deg, var(--purple-500), #7c3aed);  box-shadow: 0 8px 24px rgba(168,85,247,.4); }
        .bento-icon.red     { background: linear-gradient(135deg, var(--red-500), #dc2626);     box-shadow: 0 8px 24px rgba(239,68,68,.4); }
        .bento-icon.cyan    { background: linear-gradient(135deg, #06b6d4, #0891b2);            box-shadow: 0 8px 24px rgba(6,182,212,.4); }

        .bento-card h3 {
            font-family: var(--font-display);
            font-size: 1.35rem;
            font-weight: 700;
            letter-spacing: -.02em;
            color: #fff;
            margin-bottom: 8px;
        }
        .bento-card p {
            font-size: .88rem;
            color: var(--muted-light);
            line-height: 1.6;
        }
        .bento-card .bento-tag {
            position: absolute;
            top: 24px; right: 24px;
            font-family: 'JetBrains Mono', monospace;
            font-size: .65rem;
            color: var(--emerald-300);
            padding: 3px 10px;
            background: rgba(52,211,153,.1);
            border: 1px solid rgba(52,211,153,.25);
            border-radius: 999px;
            letter-spacing: .05em;
        }
        .bento-card .bento-arrow {
            font-size: 1.2rem;
            color: var(--emerald-400);
            transition: transform .3s;
            align-self: flex-end;
        }
        .bento-card:hover .bento-arrow { transform: translateX(6px); }

        /* Bento sizes */
        .bento-card.large {
            grid-column: span 2;
            grid-row: span 2;
            padding: 36px;
        }
        .bento-card.large h3 { font-size: 1.8rem; }
        .bento-card.wide { grid-column: span 2; }
        .bento-card.tall { grid-row: span 2; }

        /* Special: Peta 3D dengan preview */
        .bento-card.map-preview::after {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(400px 300px at 30% 60%, rgba(16,185,129,.25), transparent 60%),
                radial-gradient(400px 300px at 70% 40%, rgba(14,165,233,.2), transparent 60%);
            opacity: .5;
            pointer-events: none;
        }

        /* ============================================================
           DEMO PREVIEW
           ============================================================ */
        .demo-section {
            background: var(--navy-950);
            position: relative;
        }
        .demo-preview {
            position: relative;
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid rgba(52,211,153,.2);
            box-shadow: 0 30px 80px rgba(0,0,0,.5);
        }
        .demo-preview img,
        .demo-preview svg {
            width: 100%;
            display: block;
        }
        .demo-tabs {
            display: flex; gap: 6px; margin-bottom: 24px;
            padding: 6px;
            background: rgba(15,30,53,.6);
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 999px;
            width: fit-content;
        }
        .demo-tab {
            padding: 10px 24px;
            border-radius: 999px;
            font-size: .85rem;
            font-weight: 600;
            color: var(--muted-light);
            transition: all .25s;
            cursor: pointer;
        }
        .demo-tab.active {
            background: linear-gradient(135deg, var(--emerald-500), var(--emerald-400));
            color: var(--navy-950);
            box-shadow: 0 4px 20px rgba(16,185,129,.4);
        }

        /* ============================================================
           CTA FINAL
           ============================================================ */
        .cta-final {
            position: relative;
            padding: 100px 0;
            background: linear-gradient(135deg, var(--navy-800), var(--navy-950));
            overflow: hidden;
            text-align: center;
        }
        .cta-final::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(600px 400px at 50% 0%, rgba(16,185,129,.2), transparent 60%),
                radial-gradient(600px 400px at 50% 100%, rgba(14,165,233,.15), transparent 60%);
            pointer-events: none;
        }
        .cta-final-inner {
            position: relative;
            z-index: 1;
            max-width: 720px;
            margin: 0 auto;
        }
        .cta-final h2 {
            font-family: var(--font-display);
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 700;
            letter-spacing: -.03em;
            line-height: 1.1;
            color: #fff;
            margin-bottom: 20px;
        }
        .cta-final h2 .grad {
            background: linear-gradient(135deg, var(--emerald-300), var(--sky-400));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
        }
        .cta-final p {
            font-size: 1.05rem;
            color: var(--muted-light);
            line-height: 1.7;
            margin-bottom: 36px;
        }
        .cta-final-actions {
            display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;
        }

        /* ============================================================
           FOOTER
           ============================================================ */
        .footer {
            padding: 80px 0 0;
            background: #030711;
            border-top: 1px solid rgba(52,211,153,.1);
            position: relative;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 60px;
            margin-bottom: 60px;
        }
        .footer-brand p {
            font-size: .9rem;
            color: var(--muted-light);
            line-height: 1.7;
            margin: 20px 0;
            max-width: 360px;
        }
        .footer-region {
            display: inline-flex; align-items: center; gap: 8px;
            font-size: .85rem;
            color: var(--emerald-300);
        }
        .footer-col h4 {
            font-family: var(--font-display);
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: #fff;
            margin-bottom: 20px;
        }
        .footer-col ul { display: flex; flex-direction: column; gap: 12px; }
        .footer-col a {
            font-size: .9rem;
            color: var(--muted-light);
            transition: color .2s;
        }
        .footer-col a:hover { color: var(--emerald-300); }

        .footer-bottom {
            padding: 24px 0;
            border-top: 1px solid rgba(255,255,255,.05);
            display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px;
            font-size: .82rem;
            color: var(--muted-2);
        }

        /* ============================================================
           REVEAL ANIMATIONS
           ============================================================ */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity .9s var(--ease), transform .9s var(--ease);
        }
        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @media (max-width: 1024px) {
            .hero-inner { grid-template-columns: 1fr; gap: 40px; }
            .hero-right { height: 420px; }
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .stat-item:nth-child(2) { border-right: none; }
            .stat-item:nth-child(1),
            .stat-item:nth-child(2) { border-bottom: 1px solid rgba(52,211,153,.1); }
            .bento { grid-template-columns: repeat(2, 1fr); }
            .footer-grid { grid-template-columns: 1fr 1fr; gap: 40px; }
            .footer-brand { grid-column: 1 / -1; }
        }

        @media (max-width: 768px) {
            .nav-links { display: none; }
            .hero { padding: 100px 0 60px; min-height: auto; }
            .hero-right { height: 340px; }
            .floating-card { padding: 10px 12px; }
            .floating-card .fc-value { font-size: .95rem; }
            .fc-1, .fc-3 { left: 12px; }
            .fc-2, .fc-4 { right: 12px; }
            .fc-1, .fc-2 { top: 12px; }
            .fc-3, .fc-4 { bottom: 12px; }
            .stats-grid { grid-template-columns: 1fr; border-radius: 16px; }
            .stat-item { border-right: none; border-bottom: 1px solid rgba(52,211,153,.1); }
            .stat-item:last-child { border-bottom: none; }
            .bento { grid-template-columns: 1fr; grid-auto-rows: auto; }
            .bento-card.large,
            .bento-card.wide,
            .bento-card.tall { grid-column: auto; grid-row: auto; padding: 28px; min-height: 200px; }
            .footer-grid { grid-template-columns: 1fr; gap: 32px; }
            .demo-tabs { width: 100%; overflow-x: auto; }
        }
    </style>
</head>
<body>

